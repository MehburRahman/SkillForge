      "task_id": "scala_queue_hidden",
      "title": "UTF-8 queue API",
      "problem_statement": "Implement an in-memory FIFO queue, initially empty. POST /queue appends the UTF-8 body verbatim, including an empty body, and returns 201 with the current queue length. GET /queue removes and returns the oldest body with status 200; an empty queue returns 404 with body empty. DELETE /queue clears it and returns 204 with an empty body. GET /queue/size returns 200 with the decimal queue length. All other requests return 404 with body missing. Requests share state inside each scenario.",
      "category": "other",
      "difficulty": "hard",
      "split": "hidden",
      "language": "scala",
      "execution_mode": "http",
      "visible_tests": [
